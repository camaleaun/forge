---
import '../styles/global.css';
import { SITE } from '../data/site';
import { getCollection } from 'astro:content';

interface Props { title: string; description: string; path?: string; docs?: boolean }
const { title, description, path = '', docs: isDocs = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = title === SITE.name ? `${SITE.name}: ${SITE.pitch}` : `${title} | forge`;
const canonical = new URL(`${base}${path}`, Astro.site).href;
const image = new URL(`${base}/og-image.png`, Astro.site).href;
const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="forge" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The forge icon: a white anvil with sparks on an orange-red square" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href={`${base}/`}>
        <img src={`${base}/forge-icon.svg`} alt="" width="32" height="32" />
        <span>forge</span>
      </a>
      <nav aria-label="Main">
        <a href={`${base}/docs/getting-started/`}>Docs</a>
        <a href={`${base}/docs/roadmap/`}>Roadmap</a>
        <a href="https://github.com/camaleaun/forge">GitHub</a>
      </nav>
    </header>
    {isDocs ? (
      <div class="docs">
        <nav class="side" aria-label="Documentation">
          <ul>
            {pages.map((p) => (
              <li><a href={`${base}/docs/${p.id}/`} aria-current={path === `/docs/${p.id}/` ? 'page' : undefined}>{p.data.title}</a></li>
            ))}
          </ul>
        </nav>
        <main id="main" class="prose"><slot /></main>
      </div>
    ) : (
      <main id="main"><slot /></main>
    )}
    <footer class="foot">
      <p>forge is open source (MIT).</p>
      <ul>
        {SITE.repos.map((r) => <li><a href={r.url}>{r.name}</a> <span>{r.about}</span></li>)}
      </ul>
    </footer>
  </body>
</html>
