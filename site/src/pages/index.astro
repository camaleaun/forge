---
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';
import { SITE, helloTsx, helloCss } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const theme = { themes: { light: 'github-light-high-contrast', dark: 'github-dark-high-contrast' }, defaultColor: false } as const;
---
<Base title="forge" description="Tiny native apps from a web-like source: TSX, CSS and TypeScript. A macOS app of about 73 KB, a CLI in the same binary, browser and phone preview, and a styled DMG." path="/">
  <div class="wrap">
    <section class="hero">
      <img src={`${base}/forge-icon.svg`} alt="forge icon" width="128" height="128" />
      <h1>forge</h1>
      <p>{SITE.pitch}.</p>
      <div class="actions">
        <a class="btn primary" href={`${base}/docs/getting-started/`}>Get started</a>
        <a class="btn" href="https://github.com/camaleaun/forge">View on GitHub</a>
      </div>
    </section>

    <section aria-labelledby="hello">
      <h2 id="hello">A whole app in two small files</h2>
      <p>This is the <a href="https://github.com/camaleaun/forge-hello-world">hello world</a> app: a label, a button and a command-line flag. Markup in TSX, look in CSS, behavior in TypeScript.</p>
      <div class="code-pair">
        <figure><figcaption>App.tsx</figcaption><Code code={helloTsx} lang="tsx" {...theme} /></figure>
        <figure><figcaption>App.css</figcaption><Code code={helloCss} lang="css" {...theme} /></figure>
      </div>
    </section>

    <section aria-labelledby="get">
      <h2 id="get">What you get</h2>
      <ul class="features">
        <li><h3>A tiny macOS app</h3><p>Native AppKit code generated from your source. The hello app is about 73 KB and carries no JavaScript.</p></li>
        <li><h3>A CLI in the same binary</h3><p>Every app answers <code>--version</code>, <code>--help</code> and the flags you declare in <code>commands</code>.</p></li>
        <li><h3>Browser and phone preview</h3><p><code>forge start</code> renders the app live in a browser and on your phone over the local network.</p></li>
        <li><h3>A styled DMG</h3><p><code>.dmg</code> with a background, the app and an Applications shortcut, plus a <code>.zip</code> and a <code>latest.json</code> for updates.</p></li>
      </ul>
      <p>forge itself has no npm dependencies: Node 24 runs its TypeScript files directly, and the apps you ship are native binaries that need no Node. Linux, Windows, web and mobile are <a href={`${base}/docs/roadmap/`}>planned</a>.</p>
    </section>
  </div>
</Base>
